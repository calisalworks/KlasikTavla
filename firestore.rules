rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.id == userId &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || data.photoURL is string) &&
        (!('email' in data) || data.email is string) &&
        (!('wins' in data) || (data.wins is number && data.wins >= 0)) &&
        (!('losses' in data) || (data.losses is number && data.losses >= 0)) &&
        (!('abandoned' in data) || (data.abandoned is number && data.abandoned >= 0)) &&
        (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
        (!('level' in data) || (data.level is number && data.level >= 1 && data.level <= 100)) &&
        (!('trophies' in data) || (data.trophies is number && data.trophies >= 0)) &&
        (!('equippedFrame' in data) || (data.equippedFrame is string && data.equippedFrame.size() <= 64)) &&
        (!('lastDailyRewardDate' in data) || (data.lastDailyRewardDate is string && data.lastDailyRewardDate.size() <= 32)) &&
        (!('lastFreeCoinsClaimTimestamp' in data) || (data.lastFreeCoinsClaimTimestamp is number && data.lastFreeCoinsClaimTimestamp >= 0)) &&
        (!('adRewardsToday' in data) || (data.adRewardsToday is number && data.adRewardsToday >= 0)) &&
        (!('lastAdRewardDate' in data) || (data.lastAdRewardDate is string && data.lastAdRewardDate.size() <= 32)) &&
        (!('createdAt' in data) || data.createdAt is string) &&
        (!('lastLoginAt' in data) || data.lastLoginAt is string);
    }

    // Coin balances and reward timestamps are server-owned. A client may edit
    // ordinary profile fields, but cannot mint coins, reset cooldowns, or edit
    // ad-reward counters. Map.get defaults also handle legacy documents where
    // some of these fields do not exist yet.
    function coinStateUnchanged() {
      return request.resource.data.get('coins', null) == resource.data.get('coins', null) &&
        request.resource.data.get('lastDailyRewardDate', null) == resource.data.get('lastDailyRewardDate', null) &&
        request.resource.data.get('lastFreeCoinsClaimTimestamp', null) == resource.data.get('lastFreeCoinsClaimTimestamp', null) &&
        request.resource.data.get('adRewardsToday', null) == resource.data.get('adRewardsToday', null) &&
        request.resource.data.get('lastAdRewardDate', null) == resource.data.get('lastAdRewardDate', null);
    }

    function hasValidInitialBalance(data) {
      return !('coins' in data) || data.coins == 500;
    }

    // Public user profile (NO PII / email is stored here)
    match /users/{userId} {
      allow get: if true;
      allow list: if false; // Deny broad query scraping
      allow create: if isOwner(userId) &&
        isValidUser(request.resource.data, userId) &&
        hasValidInitialBalance(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidUser(request.resource.data, userId) &&
        coinStateUnchanged() &&
        request.resource.data.id == resource.data.id &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if false;

      // Immutable coin transaction records for this user
      match /coinTransactions/{txId} {
        allow get, list: if isOwner(userId);
        // Only a trusted server using the Admin SDK may append ledger records.
        // Client SDK writes are denied; Admin SDK operations bypass these rules.
        allow create, update, delete: if false;
      }

      // Private user subcollection for any sensitive or private settings
      match /private/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
